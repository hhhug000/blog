---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, author = 'Hugo', tags = [] } = Astro.props;

// Helper to format dates like "August 15th, 2023"
function formatOrdinalDate(date: Date) {
	const day = date.getDate();
	const month = date.toLocaleDateString('en-US', { month: 'long' });
	const year = date.getFullYear();

	const nth = (d: number) => {
		if (d > 3 && d < 21) return 'th';
		switch (d % 10) {
			case 1: return 'st';
			case 2: return 'nd';
			case 3: return 'rd';
			default: return 'th';
		}
	};

	return { month, day, suffix: nth(day), year };
}

const { month, day, suffix, year } = formatOrdinalDate(pubDate);
---

<!doctype html>
<html lang="en">
<head>
	<BaseHead title={title} description={description} />
</head>
<body>
<div class="app-wrapper">
	<Header />

	<main class="main-content">
		<article class="single-post">
			<header class="post-header">
				<h1 class="post-title">{title}</h1>

				<div class="post-meta">
					<img src="/avatar.jpeg" alt={author} class="meta-avatar" />
					<span class="meta-author">{author}</span>
					<span class="meta-dot">·</span>
					<span class="meta-date">
								{month} {day}<sup>{suffix}</sup>, {year}
							</span>

					{tags.length > 0 && (
						<>
							<span class="meta-dot">·</span>
							<div class="meta-tags">
								{tags.map((tag) => (
									<span class="tag">#{tag}</span>
								))}
							</div>
						</>
					)}
				</div>
			</header>

			{updatedDate && (
				<div class="last-updated">
					Last updated on {updatedDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
				</div>
			)}

			<hr class="post-divider" />

			<div class="post-content">
				<slot />
			</div>
		</article>
	</main>
</div>
</body>
</html>