---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

// Fetch and sort posts by date (newest first), taking only the top 5
const posts = (await getCollection('blog', ({ data }) => {
	return import.meta.env.DEV ? true : data.published;
})).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 5);
---

<!doctype html>
<html lang="en">
<head>
	<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
</head>
<body>
<div class="app-wrapper">
	<Header />

	<main class="main-content">
		<h1>Welcome to my blog</h1>

		<p>
			Hi! I'm Hugo, I enjoy programming and electronics.
		</p>
		<p>
			In my free time I work on my homelab, building hardware projects, and writing open source software projects.
		</p>
		<p>
			Some of my past projects include:
		</p>

		<ul>
			<li>
				<a href="https://github.com/hhhug000/octoboard">Octoboard - An 8-bit microcontroller board based around the ATMega328P (Hardware)</a>
			</li>
			<li>
				<a href="https://github.com/mote-editor/mote">Mote - A tiny terminal text editor (Software)</a>
			</li>
			<li>
				<a href="https://github.com/mote-editor/mote">Spur - A simple static site generator i'm writing to learn Go (Software) (Work In Progress)</a>
			</li>
		</ul>

		<p>
			This website is a place for me to write about anything that I feel like.
		</p>

		<p>
			If you want to see any of my writing, you can press the blog link in the menu bar, or see the last 5 below:
		</p>

		<ul>
			{
				posts.map((post) => (
					<li>
						<a href={`/blog/${post.id}/`}>{post.data.title}</a>
					</li>
				))
			}
		</ul>
	</main>
</div>
</body>
</html>