<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>Logging in...</title>
</head>
<body>
<p>Redirecting to login...</p>

<script>
    // 1. Get the current site's origin (e.g., https://hhhug000.github.io)
    const origin = window.location.origin;

    // 2. Build the full callback URL for this specific site
    // Handles path prefixes automatically if your site is hosted under a subdirectory (like /blog)
    const callbackPath = window.location.pathname.replace(/\/login\/?$/, '/keystatic-callback');
    const redirectUri = `${origin}${callbackPath}`;

    // 3. Construct the adapter URL with the dynamic redirect_uri parameter
    const adapterUrl = `https://rocket.haaxman.co.uk/hugowebdev/adapter.php?redirect_uri=${encodeURIComponent(redirectUri)}`;

    // 4. Send the user to the adapter
    window.location.href = adapterUrl;
</script>
</body>
</html>